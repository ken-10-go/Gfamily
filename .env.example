# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
#
# ここに入る Firebase のクライアント設定は「公開前提」の値です（アプリのバンドルに
# 埋め込まれます）。秘密鍵ではありませんが、プロジェクトごとに異なるため環境変数で持ちます。
# 実際のアクセス制御は firestore.rules で行うため、ルールを適用せずに公開しないでください。
#
# 値の取得元: Firebase コンソール > プロジェクトの設定 > マイアプリ > SDK の設定と構成

VITE_FIREBASE_API_KEY=AIzaSyExample
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ローカルのエミュレータに接続する場合は true にする（npm run emulators と併用）
VITE_USE_FIREBASE_EMULATORS=false

# 配信先のベースパス。Firebase Hosting はルート配信なので / のまま。
# GitHub Pages のサブパス配信に切り替える場合のみ /<リポジトリ名>/ を指定する。
VITE_BASE_PATH=/
