# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
# .env は .gitignore 済みです。実際の値をコミットしないでください。

# Supabase プロジェクトの URL（Project Settings > API > Project URL）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase の anon public key（Project Settings > API > anon public）
# 公開鍵なのでフロントに埋め込まれる前提。実際のアクセス制御は RLS で行うこと。
# service_role key は絶対にここに書かない。
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 配信先のベースパス。ルート配信なら / のまま。
# GitHub Pages のサブパス配信では /<リポジトリ名>/ を指定する。
VITE_BASE_PATH=/
