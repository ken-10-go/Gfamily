rules_version = '2';

// ============================================================================
// 家系図共有アプリ セキュリティルール
//
// 設計方針:
//   * 権限はツリー文書の roles マップ（uid -> 'owner'|'editor'|'viewer'）で持つ
//   * 人物や関係はツリーのサブコレクションに置き、親ツリーの roles で判定する
//   * 招待と監査ログはクライアントから書けない。Cloud Functions（Admin SDK）だけが書く
//   * 明示的に許可した操作以外はすべて拒否される
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function treeRoles(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId)).data.roles;
    }

    function isMember(treeId) {
      return isSignedIn() && request.auth.uid in treeRoles(treeId);
    }

    function canEdit(treeId) {
      return isMember(treeId) && treeRoles(treeId)[request.auth.uid] in ['owner', 'editor'];
    }

    function isOwner(treeId) {
      return isMember(treeId) && treeRoles(treeId)[request.auth.uid] == 'owner';
    }

    // roles と memberIds が食い違うと、一覧クエリと権限判定がずれて事故になる。
    // memberIds は array-contains で「自分が参加しているツリー」を引くためだけに存在する。
    function membersAreConsistent(data) {
      return data.memberIds.toSet() == data.roles.keys().toSet();
    }

    // ツリーからオーナーが居なくなる更新を防ぐ
    function hasAnyOwner(data) {
      return data.roles.values().hasAny(['owner']);
    }

    // Firestore のトリガーは Postgres のトリガーと違い「誰が実行したか」を受け取れない。
    // そこで実行者を updatedBy として書かせ、詐称できないことをここで担保する。
    // これにより監査ログの「誰が」を信頼できる（記録自体はトリガーが必ず行う）。
    function actorIsSelf() {
      return request.resource.data.updatedBy == request.auth.uid;
    }

    match /trees/{treeId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.roles;

      // 一覧は必ず memberIds の array-contains で絞る前提。
      // 他人のツリーを含むクエリはこのルールに阻まれて丸ごと失敗する。
      //
      // ここで roles マップを見ないのは、list の評価では resource.data のマップ項目を
      // 参照できず「Property roles is undefined」になるため。memberIds は roles と
      // 同じ内容を持つ配列で、整合性は membersAreConsistent() で強制している。
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // 作成時は自分だけがオーナーの状態しか認めない
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && membersAreConsistent(request.resource.data);

      // 権限の変更・メンバーの削除はオーナーのみ。ただし最後のオーナーは残す。
      allow update: if isOwner(treeId)
        && request.resource.data.createdBy == resource.data.createdBy
        && membersAreConsistent(request.resource.data)
        && hasAnyOwner(request.resource.data);

      // 削除は deleteTree() Cloud Function 経由のみ。
      // ここで直接削除を許すと、配下のサブコレクション（人物・関係・監査ログ）が
      // 消えずに残り、個人情報が到達不能なまま保持され続けてしまう。
      allow delete: if false;

      // 機微項目（本籍地・戒名など）は端末で暗号化してから送られてくる。
      // 中身はサーバー側では読めないので、形と大きさだけを見る。
      // 上限は「思い出のメモ4000字ぶんが Base64 で膨らんでも収まる」大きさにしている。
      function encryptedDataIsValid(data) {
        return !('encryptedData' in data.keys())
          || data.encryptedData == null
          || (data.encryptedData.keys().hasOnly(['iv', 'ciphertext', 'tag'])
              && data.encryptedData.iv is string
              && data.encryptedData.ciphertext is string
              && data.encryptedData.tag is string
              && data.encryptedData.ciphertext.size() < 30000);
      }

      match /persons/{personId} {
        // 読めるのはこのツリーのメンバーだけ。
        // 他家との合同表示は止めてある（下の treeBridges のコメント）。
        // 再開するときは `&& resource.data.isLiving == false` を添えて
        // 故人だけに絞ること（生存者の情報を他家へ渡さない、が仕様の核）。
        allow read: if isMember(treeId);
        // 削除はソフト削除（deletedAt）で行うため、update で足りる
        allow create, update: if canEdit(treeId)
          && actorIsSelf()
          && encryptedDataIsValid(request.resource.data);
        allow delete: if isOwner(treeId);
      }

      match /parentChild/{linkId} {
        allow read: if isMember(treeId);
        allow create, update: if canEdit(treeId) && actorIsSelf();
        allow delete: if isOwner(treeId);
      }

      match /unions/{unionId} {
        allow read: if isMember(treeId);
        allow create, update: if canEdit(treeId) && actorIsSelf();
        allow delete: if isOwner(treeId);
      }

      /*
       * 家（ツリーの中の、血のつながりでまとまった一群）。
       *
       * 名前しか持たない軽い文書で、個人情報は入らない。
       * 既定では自動で判定するので、ここに登録があるのは
       * 名前を付け直した家と、所属を手で決めた家だけ。
       */
      match /houses/{houseId} {
        allow read: if isMember(treeId);
        allow create, update: if canEdit(treeId) && actorIsSelf();
        allow delete: if canEdit(treeId);
      }

      /*
       * ご意見・不具合。家族から「使いにくい」「動かない」を受け取る窓口。
       *
       * メンバーなら誰でも出せる（困っているのは閲覧者のことが多い）。
       * 投稿はメンバー全員が読める。同じ報告が重なりにくく、放置にも見えないため。
       * 状態を進められるのはオーナーだけで、**本文は誰も書き換えられない**
       * （読み手が書き換えられると、送った人の言葉として信用できなくなる）。
       */
      match /feedback/{feedbackId} {
        allow read: if isMember(treeId);
        allow create: if isMember(treeId)
          && actorIsSelf()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update: if isOwner(treeId)
          && actorIsSelf()
          && request.resource.data.status in ['open', 'doing', 'done']
          && request.resource.data.body == resource.data.body
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isOwner(treeId) || resource.data.createdBy == request.auth.uid;
      }

      // 招待はオーナーだけが見られる。発行・受諾・取り消しは Cloud Functions 経由。
      // クライアントに書き込みを許すと、自分で自分をオーナーに招待できてしまう。
      match /invitations/{invitationId} {
        allow read: if isOwner(treeId);
        allow write: if false;
      }

      /*
       * 監査ログは、書き足せない・書き換えられない。
       * 記録そのものは Cloud Functions（Admin SDK）だけが作る。
       *
       * ⚠ 消すことだけはオーナーに許している。
       * 「記録を消せない」ほうが監査としては強いが、家族で使う道具なので
       * 「試した跡や消した人の記録をいつまでも残したくない」という求めのほうを採った。
       * 消せるのは丸ごとで、選んで消すことはできない（都合の悪い1件だけを
       * 消せると、残っている記録まで信用できなくなるため）。
       */
      match /auditLogs/{logId} {
        allow read: if isMember(treeId);
        allow create, update: if false;
        allow delete: if isOwner(treeId);
      }
    }

    /*
     * 呼び名（ニックネーム）。
     *
     * メンバーの一覧で人を見分けるために使う。誰でも読めるが、書けるのは本人だけ。
     * ログインに使うアドレスは**ここには置かない**（オーナーだけが管理画面で見る）。
     * 家系図をまたいで同じ呼び名を使うので、ツリーの下ではなく上に置いている。
     */
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && (request.resource.data.keys().hasOnly(['nickname', 'updatedAt']))
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20;
    }

    // --- 他家とのつながり（いまは止めてある） -------------------------------
    //
    // この仕組みは「相手の家系図を読んでよい」という認可そのものなので、
    // クライアントから書けると **自分で自分に認可を配れてしまう**。
    // 実際そうなっていた（ログインできる人なら誰でも、相手の承認なしに
    // 任意の家系図を読めた）ので、読み書きとも閉じた。
    // 合同表示は画面からも外してある（BridgesPage は案内だけを出す）。
    //
    // 再開するときにやること:
    //   1. ここを Cloud Functions だけが書ける形に戻す（allow write: if false のまま、
    //      申請・承認・解除は functions/src/index.ts の実装を使う）
    //   2. 自分に配られた認可を読めるように allow read を戻す
    //   3. trees/persons/parentChild/unions/houses の read に hasBridgeTo を足し直す
    //      （persons には `&& resource.data.isLiving == false` を必ず添える）
    //   4. src/lib/api.ts の BRIDGES_ENABLED を true にし、
    //      connectTree / previewTree / revokeBridge を Functions 呼び出しに戻す
    //   5. ルールのテストを戻し、Functions を手元からデプロイする
    match /treeBridges/{bridgeId} {
      allow read, write: if false;
    }

    // 上記に当てはまらないパスはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
